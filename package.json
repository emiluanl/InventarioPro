{
  "name": "inventariopro-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Tests e2e de navegador (Playwright) para InventarioPro",
  "scripts": {
    "start": "bash scripts/start.sh",
    "dev": "bash scripts/start.sh",
    "stop": "bash scripts/stop.sh",
    "status": "bash scripts/status.sh",
    "test:e2e": "playwright test",
    "test:e2e:local": "bash scripts/e2e-local.sh",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "verify:prod": "bash scripts/verify-prod-health.sh",
    "test-users": "bash scripts/clean-test-users.sh",
    "test-users:clean": "bash scripts/clean-test-users.sh --delete",
    "setup:staging": "bash scripts/setup-staging.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
