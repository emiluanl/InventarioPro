# Dependencias (cada subproyecto tiene su propio node_modules)
node_modules/

# Builds
backend/dist/
frontend/.next/
frontend/.next-e2e/
frontend/.next-pwa/
frontend/out/

# App de escritorio (desktop/): stack ensamblado, iconos e instaladores.
# desktop/certs/ contiene la clave privada de firma (pfx) — nunca se commitea.
desktop/dist/
desktop/resources/
desktop/build/
desktop/certs/

# Playwright (e2e)
e2e/.tmp/
playwright-report/
test-results/

# Entorno (NUNCA subir)
.env
.env.local
.env.prod
.env.*.local

# Dumps de backup (volumen ./backups del compose de producción)
backups/

# Config real de rclone con credenciales (el example sí se commitea).
# rclone.conf.* cubre copias accidentales (.bak, .tmp...) que también llevan
# credenciales y no deben commitearse.
rclone/rclone.conf
rclone/rclone.conf.*

# Estado local de la herramienta de edición
.freebuff/

# Archivos subidos localmente (cuando STORAGE_PROVIDER=local)
backend/uploads/*
!backend/uploads/.gitkeep

# Logs
*.log

# Sistema operativo
.DS_Store
Thumbs.db

# IDEs
.idea/
.vscode/
*.swp

# TypeScript build info
*.tsbuildinfo
