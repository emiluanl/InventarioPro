# =============================================================================
# PLANTILLA — Microsoft Artifact Signing (DESHABILITADA)
# =============================================================================
# Termina en `.template` para que GitHub NO lo ejecute. Para activarla:
# renombrar a `desktop-signing.yml`, crear los recursos de Azure y secretos
# (ver docs/ARTIFACT-SIGNING.md), y dispararla MANUALMENTE (workflow_dispatch)
# la primera vez — sin tags ni GitHub Release.
#
# FIRMA (hook de electron-builder, scripts/sign-with-artifact-signing.js):
#   electron-builder invoca el hook para InventarioPro.exe, elevate.exe y el
#   __uninstaller.exe DURANTE el empaquetado → quedan firmados DENTRO del
#   instalador. El instalador final se firma aparte (paso post-empaquetado).
#   El hook usa Artifact Signing si AS_* está definido; fallback PFX si
#   WIN_CSC_LINK está definido; sin credenciales → sin firma.
#
# Requiere (configurado manualmente por el propietario, NO automatizado):
#   - Cuenta de Artifact Signing + validación de identidad + perfil Public Trust
#   - Rol "Artifact Signing Certificate Profile Signer" en el App Registration
#   - App Registration + Federated Credential (OIDC) para este repo
#   - Secrets:  AZURE_CLIENT_ID, AZURE_TENANT_ID, AZURE_SUBSCRIPTION_ID
#   - Variables: AS_ENDPOINT, AS_SIGNING_ACCOUNT, AS_CERT_PROFILE
#   - Environment protegido "release" (reviewers) en Settings → Environments
#   - Runner: Windows SDK signtool (windows-2022 lo incluye) + .NET 8 runtime
#     + "Artifact Signing Client Tools" (dlib) — se instalan/descubren abajo.
# =============================================================================

name: Desktop Signing (Artifact Signing) — TEMPLATE

on:
  workflow_dispatch:
    inputs:
      # Modo PRUEBA por defecto: no crea tags ni GitHub Release. Solo sube
      # artifacts con el instalador de prueba firmado.
      mode:
        description: 'test (default) | release'
        required: true
        default: 'test'
        type: choice
        options: ['test', 'release']
  # SOLO activar el trigger de tags cuando el modo test haya pasado.
  # push:
  #   tags: ['v*']

# id-token: write es OBLIGATORIO para OIDC → Azure. contents: read es el mínimo.
# Sin contents: write este workflow JAMÁS crea releases.
permissions:
  id-token: write
  contents: read

concurrency:
  group: signing-${{ github.event_name }}-${{ inputs.mode || github.ref }}
  cancel-in-progress: false

jobs:
  build-and-sign:
    name: Build + firma (hook electron-builder) + instalador final
    runs-on: windows-2022
    timeout-minutes: 90
    environment: release

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: npm
          cache-dependency-path: |
            backend/package-lock.json
            frontend/package-lock.json
            desktop/package-lock.json

      - name: Install backend deps
        working-directory: backend
        run: npm ci

      - name: Install frontend deps
        working-directory: frontend
        run: npm ci

      - name: Install desktop deps
        working-directory: desktop
        run: npm ci

      # ------------------------------------------------------------------
      # Prerrequisitos de firma (sin PFX, sin secretos): cliente de
      # Artifact Signing + signtool del Windows SDK + .NET 8.
      # ------------------------------------------------------------------
      - name: Instalar Artifact Signing Client Tools (dlib)
        shell: pwsh
        run: |
          winget install --id Microsoft.Azure.ArtifactSigningClientTools `
            --accept-source-agreements --accept-package-agreements --silent
          if ($LASTEXITCODE -ne 0) {
            # Fallback: MSI oficial documentado en Microsoft Learn.
            $ProgressPreference = 'SilentlyContinue'
            $msi = "$env:TEMP\ArtifactSigningClientTools.msi"
            Invoke-WebRequest -Uri "https://download.microsoft.com/download/70ad2c3b-761f-4aa9-a9de-e7405aa2b4c1/ArtifactSigningClientTools.msi" -OutFile $msi
            Start-Process msiexec.exe -Wait -ArgumentList "/I $msi /quiet"
          }
          Write-Host "Client tools OK"

      - name: Descubrir signtool.exe (Windows SDK) y Azure.CodeSigning.Dlib.dll
        shell: pwsh
        run: |
          $sdk = Get-ChildItem "C:\Program Files (x86)\Windows Kits\10\bin" -Directory |
            Where-Object { $_.Name -match '^\d+\.' } |
            Sort-Object Name -Descending | Select-Object -First 1
          $signtool = Join-Path $sdk.FullName "x64\signtool.exe"
          if (-not (Test-Path $signtool)) { throw "Falta signtool.exe en el Windows SDK del runner" }
          "SIGNTOOL_PATH=$signtool" | Out-File -FilePath $env:GITHUB_ENV -Append
          $dlib = Get-ChildItem "C:\Program Files" -Recurse -Filter "Azure.CodeSigning.Dlib.dll" -ErrorAction SilentlyContinue |
            Select-Object -First 1
          if (-not $dlib) { throw "Falta Azure.CodeSigning.Dlib.dll (Artifact Signing Client Tools)" }
          "AS_DLIB_PATH=$($dlib.FullName)" | Out-File -FilePath $env:GITHUB_ENV -Append
          Write-Host "signtool: $signtool"
          Write-Host "dlib: $($dlib.FullName)"

      - name: Verificar .NET 8 runtime (requerido por el dlib)
        shell: pwsh
        run: |
          $runtimes = dotnet --list-runtimes
          if ($runtimes -notmatch 'Microsoft.NETCore.App 8\.') {
            Write-Host "Falta .NET 8 runtime — el dlib de Artifact Signing no funcionará."
            Write-Host ($runtimes -join "`n")
            throw "Se requiere .NET 8 runtime para el dlib (instalar: winget install Microsoft.DotNet.Runtime.8)"
          }
          Write-Host "".NET 8 runtime OK""

      # ------------------------------------------------------------------
      # Autenticación OIDC → Azure (sin client-secret, sin PFX).
      # ------------------------------------------------------------------
      - name: Azure login (OIDC)
        uses: azure/login@v3
        with:
          client-id: ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID }}

      # ------------------------------------------------------------------
      # Build + empaquetado. El hook de firma (electron-builder) firma
      # InventarioPro.exe, elevate.exe y el __uninstaller DURANTE el
      # empaquetado con Artifact Signing (AS_* definidos).
      # ------------------------------------------------------------------
      - name: Build stack + instalador (hook firma los internos)
        working-directory: desktop
        shell: bash
        env:
          AS_ENDPOINT: ${{ vars.AS_ENDPOINT }}
          AS_SIGNING_ACCOUNT: ${{ vars.AS_SIGNING_ACCOUNT }}
          AS_CERT_PROFILE: ${{ vars.AS_CERT_PROFILE }}
          SIGNTOOL_PATH: ${{ env.SIGNTOOL_PATH }}
          AS_DLIB_PATH: ${{ env.AS_DLIB_PATH }}
        run: bash scripts/build.sh --installer

      # Instalador final (exe): se firma DESPUÉS del empaquetado con la
      # acción de Artifact Signing. Timestamp RFC3161 obligatorio.
      - name: Firmar instalador final
        uses: azure/artifact-signing-action@v2
        with:
          endpoint: ${{ vars.AS_ENDPOINT }}
          signing-account-name: ${{ vars.AS_SIGNING_ACCOUNT }}
          certificate-profile-name: ${{ vars.AS_CERT_PROFILE }}
          files: ${{ github.workspace }}\desktop\dist\InventarioPro-Setup-*.exe
          file-digest: SHA256
          timestamp-rfc3161: http://timestamp.acs.microsoft.com
          timestamp-digest: SHA256

      # ------------------------------------------------------------------
      # Verificación posterior: TODOS los ejecutables (instalador, exes
      # internos, uninstaller) deben estar firmados, con timestamp, y el
      # Subject NO debe ser el certificado autofirmado local.
      # ------------------------------------------------------------------
      - name: Verificar firmas (instalador + binarios internos)
        shell: pwsh
        run: |
          $targets = @()
          $targets += Get-ChildItem "desktop/dist/InventarioPro-Setup-*.exe"
          $targets += Get-ChildItem "desktop/dist/win-unpacked\*.exe" -ErrorAction SilentlyContinue
          $targets += Get-ChildItem "desktop/dist/win-unpacked\resources" -Recurse -Include *.exe -ErrorAction SilentlyContinue
          $localThumb = "885634401FAD34FC52D7FC16A38955D682DF456C"
          foreach ($f in $targets) {
            $sig = Get-AuthenticodeSignature $f.FullName
            if ($sig.Status -eq 'NotSigned' -or -not $sig.SignerCertificate) {
              throw "NO firmado: $($f.Name) (Status=$($sig.Status))"
            }
            if (-not $sig.TimeStamperCertificate) {
              throw "SIN TIMESTAMP: $($f.Name)"
            }
            if ($sig.SignerCertificate.Thumbprint -eq $localThumb) {
              throw "FIRMA AUTOFIRMADA (no Artifact Signing): $($f.Name)"
            }
            Write-Host "OK: $($f.Name) | $($sig.SignerCertificate.Subject) | ts=True"
          }

      - name: Generar SHA-256 del instalador
        shell: pwsh
        run: |
          $exe = Get-ChildItem "desktop/dist/InventarioPro-Setup-*.exe" |
            Sort-Object LastWriteTime -Descending | Select-Object -First 1
          $hash = (Get-FileHash $exe.FullName -Algorithm SHA256).Hash.ToLower()
          "SHA256 ($($exe.Name)) = $hash" | Set-Content "desktop/dist/checksums.txt"
          Get-Content "desktop/dist/checksums.txt"

      - name: Upload instalador + checksums
        uses: actions/upload-artifact@v4
        with:
          name: InventarioPro-Setup-firmado
          path: |
            desktop/dist/InventarioPro-Setup-*.exe
            desktop/dist/checksums.txt
          retention-days: 14
