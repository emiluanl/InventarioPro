# =============================================================================
# .env.prod.example — plantilla de producción (SIN secretos, se commitea).
# =============================================================================
# Copia este archivo a .env.prod en el SERVIDOR (nunca se sube a git) y completa
# los valores reales. Guía completa y generación de secretos:
#   docs/DEPLOYMENT.md §2-§3  (openssl rand, dominio único, HTTPS con Caddy)
#
# Dominio único: frontend + API bajo el MISMO dominio (Caddy enruta /api/* y
# /uploads/* al backend); las cookies httpOnly + Secure + SameSite=Strict
# funcionan sin tratarse como cross-site.
# =============================================================================

# Dominio único (frontend + API bajo el mismo dominio; Caddy enruta /api/*
# y /uploads/* al backend)
FRONTEND_DOMAIN=app.tudominio.com

# API expuesta al frontend (mismo dominio, prefijo /api)
PUBLIC_API_URL=https://app.tudominio.com/api

# CORS: solo el dominio exacto
CORS_ORIGIN=https://app.tudominio.com

# Base URL para links en emails (verificación, reset)
APP_BASE_URL=https://app.tudominio.com

# Base de datos
POSTGRES_USER=inventariopro
POSTGRES_PASSWORD=genera-con-openssl-rand-hex-24
POSTGRES_DB=inventariopro

# Redis
REDIS_PASSWORD=genera-con-openssl-rand-hex-24

# JWT (generar: openssl rand -hex 32)
JWT_ACCESS_SECRET=access-secret-de-32-chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Email (SMTP real)
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_USER=noreply@tudominio.com
SMTP_PASSWORD=tu-smtp-password
SMTP_FROM="InventarioPro <noreply@tudominio.com>"

# Storage de archivos. Local (despliegue actual: ./backend/uploads, montado en
# el contenedor y empaquetado en los backups) o Supabase (opcional):
STORAGE_PROVIDER=local
# Solo si STORAGE_PROVIDER=supabase:
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_KEY=tu-service-key
# SUPABASE_BUCKET=inventariopro

# IA (DeepSeek, compatible con OpenAI). Sin key el chat usa un fallback amable.
DEEPSEEK_API_KEY=tu-clave-DeepSeek
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=10000
# Presupuesto TOTAL de la llamada a la IA (timeouts de todos los intentos + reintentos): el fallback amable responde al agotarse.
DEEPSEEK_TOTAL_BUDGET_MS=15000

# Web Push (notificaciones fuera de la app) - opcional
# Genera las claves una sola vez con: npx web-push generate-vapid-keys --json
# Sin ellas el push queda deshabilitado (el resto de la app funciona igual).
VAPID_PUBLIC_KEY=tu-clave-publica-vapid
VAPID_PRIVATE_KEY=tu-clave-privada-vapid
VAPID_SUBJECT=mailto:admin@tudominio.com

# --- Backups (ver DEPLOYMENT.md §7-8) ---------------------------------------
# Horario del dump diario (cron) y retención.
# BACKUP_SCHEDULE="0 3 * * *"
# BACKUP_KEEP_DAYS=14
# TZ=America/Argentina/Buenos_Aires

# Heartbeats de healthchecks.io (crear dos checks: ver DEPLOYMENT.md §8).
# MONITOR_PING_URL=https://hc-ping.com/<check-api>
# BACKUP_PING_URL=https://hc-ping.com/<check-backs>

# Copia remota de los dumps (rclone, opcional; ver DEPLOYMENT.md §7).
# RCLONE_REMOTE=b2backup:InventarioPro

# Webhook de alerta directa (opcional; solo cuando el estado cambia).
# MONITOR_WEBHOOK_URL=https://hooks.slack.com/services/...
# MONITOR_WEBHOOK_TOKEN=opcional
