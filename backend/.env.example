[TEMPLATE]
# =============================================================================
# InventarioPro - Backend (variables de entorno)
# Copia este archivo a ".env" y rellena los valores reales.
# NUNCA subas el archivo .env al repositorio (ya está en .gitignore).
# =============================================================================

# ---- Entorno ----
NODE_ENV=development
PORT=3001
API_PREFIX=api
CORS_ORIGIN=http://localhost:3010

# ---- Base de datos (PostgreSQL) ----
DATABASE_URL=postgresql://inventariopro:inventariopro@localhost:5432/inventariopro?schema=public

# ---- Redis (cache, rate limiting, sesiones) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- JWT ----
# Usa strings aleatorios largos en producción (ej: `openssl rand -hex 32`)
# Nota: el refresh token NO es un JWT (token opaco hasheado en BD), por lo que
# solo existe JWT_ACCESS_SECRET. El TTL del refresh se configura con JWT_REFRESH_TTL.
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Email (verificación + recuperación de contraseña) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=replace-me
SMTP_FROM="InventarioPro <noreply@example.com>"
APP_BASE_URL=http://localhost:3010

# ---- Almacenamiento de archivos ----
# STORAGE_PROVIDER: "local" (escribe en /uploads) o "supabase"
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=inventariopro

# ---- IA (DeepSeek, API compatible con OpenAI) ----
# Sin key el chat responde con un fallback amable (no rompe la app).
DEEPSEEK_API_KEY=replace-with-your-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=10000

# ---- Web Push (notificaciones fuera de la app) ----
# Genera las claves con: npx web-push generate-vapid-keys --json
# Sin estas variables el push queda deshabilitado (la app sigue funcionando).
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:admin@tu-dominio.com

# ---- Rate limiting de auth (opcional, defaults seguros en producción) ----
# Los e2e locales suben estos límites para que los tests en paralelo no se
# bloqueen entre sí; en producción NO los definas (se usan los valores por
# defecto: 5 login/15min por IP, 100 registros/hora, 3 forgot/hora, etc.).
# THROTTLE_LOGIN_LIMIT=5
# THROTTLE_REGISTER_LIMIT=100
# THROTTLE_REFRESH_LIMIT=10
# THROTTLE_FORGOT_LIMIT=3
# THROTTLE_RESEND_LIMIT=3
